<?xml version="1.0" encoding="UTF-8"?>
<effect name="Deep Glow" category="Lighting">
	<row name="Threshold">
		<field type="double" min="0" max="1" default="0.55" id="threshold"/>
	</row>
	<row name="Radius">
		<field type="double" min="0" max="400" default="36" id="radius"/>
	</row>
	<row name="Deep Radius">
		<field type="double" min="0" max="800" default="160" id="deepradius"/>
	</row>
	<row name="Deep Mix">
		<field type="double" min="0" max="1" default="0.45" id="deepmix"/>
	</row>
	<row name="Passes">
		<field type="double" min="1" max="64" default="5" id="passes"/>
	</row>
	<row name="Exposure">
		<field type="double" min="0" max="8" default="1.4" id="exposure"/>
	</row>
	<row name="Gamma">
		<field type="double" min="0.2" max="3" default="1" id="gamma"/>
	</row>
	<row name="Saturation">
		<field type="double" min="0" max="2" default="1" id="saturation"/>
	</row>
	<row name="Tint">
		<field type="color" hex="#ffffff" id="tint"/>
	</row>
	<row name="Method">
		<field type="combo" default="0" id="method">
			<option>Gaussian</option>
			<option>Bokeh</option>
			<option>Anamorphic</option>
		</field>
	</row>
	<shader vert="../COMMON/common.vert" frag="deepglow.frag"/>
</effect>
