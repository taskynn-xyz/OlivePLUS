<?xml version="1.0" encoding="UTF-8"?>
<effect name="Repeater Grid" category="Motion Graphics">
	<row name="Columns">
		<field type="double" min="1" default="4" max="32" id="columns"/>
	</row>
	<row name="Rows">
		<field type="double" min="1" default="3" max="32" id="rows"/>
	</row>
	<row name="Gap">
		<field type="double" min="0" default="0.1" max="0.9" id="gap"/>
	</row>
	<row name="Roundness">
		<field type="double" min="0" default="0.5" max="1" id="roundness"/>
	</row>
	<row name="Scroll X">
		<field type="double" min="-1" default="0" max="1" id="offset_x"/>
	</row>
	<row name="Scroll Y">
		<field type="double" min="-1" default="0" max="1" id="offset_y"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="repeaterGrid.frag"/>
</effect>
