<?xml version="1.0" encoding="UTF-8"?>
<effect name="Light Leak" category="Motion Graphics">
	<row name="Intensity">
		<field type="double" min="0" default="0.8" max="2" id="intensity"/>
	</row>
	<row name="Width">
		<field type="double" min="0.2" default="3" max="12" id="width"/>
	</row>
	<row name="Speed">
		<field type="double" min="0" default="1" max="4" id="speed"/>
	</row>
	<row name="Tint">
		<field type="color" hex="#ff9e5e" id="tint"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="lightLeak.frag"/>
</effect>
