<?xml version="1.0" encoding="UTF-8"?>
<effect name="Halftone" category="Motion Graphics">
	<row name="Cell Size">
		<field type="double" min="3" default="9" max="40" id="cellsize"/>
	</row>
	<row name="Screen Angle">
		<field type="double" min="0" default="45" max="180" id="angle"/>
	</row>
	<row name="Strength">
		<field type="double" min="0" default="1" max="1" id="strength"/>
	</row>
	<row name="Softness">
		<field type="double" min="0" default="0.6" max="1" id="softness"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="halftone.frag"/>
</effect>
