<?xml version="1.0" encoding="UTF-8"?>
<effect name="Infinite Tunnel" category="Motion Graphics">
	<row name="Speed">
		<field type="double" min="0" default="1" max="4" id="speed"/>
	</row>
	<row name="Twist">
		<field type="double" min="-6" default="1.5" max="6" id="twist"/>
	</row>
	<row name="Rings">
		<field type="double" min="1" default="8" max="30" id="rings"/>
	</row>
	<row name="Glow">
		<field type="double" min="0" default="0.6" max="2" id="glow"/>
	</row>
	<row name="Tint A">
		<field type="color" hex="#00e5ff" id="tinta"/>
	</row>
	<row name="Tint B">
		<field type="color" hex="#ff2d95" id="tintb"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="infiniteTunnel.frag"/>
</effect>
