<?xml version="1.0" encoding="UTF-8"?>
<effect name="Linear Wipe" category="Motion Graphics">
	<row name="Progress">
		<field type="double" min="0" default="50" max="100" id="progress"/>
	</row>
	<row name="Angle">
		<field type="double" min="0" default="0" max="360" id="angle"/>
	</row>
	<row name="Softness">
		<field type="double" min="0" default="2" max="50" id="softness"/>
	</row>
	<row name="Reverse">
		<field type="double" min="0" default="0" max="1" id="reverse"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="motionWipe.frag"/>
</effect>
