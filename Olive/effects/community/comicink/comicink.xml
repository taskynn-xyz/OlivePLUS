<?xml version="1.0" encoding="UTF-8"?>
<effect name="Comic Ink" category="Stylize">
	<row name="Levels">
		<field type="double" min="2" max="16" default="4" id="levels"/>
	</row>
	<row name="Ink">
		<field type="double" min="0" max="4" default="1.5" id="ink"/>
	</row>
	<row name="Line Width">
		<field type="double" min="1" max="15" default="2" id="linewidth"/>
	</row>
	<row name="Saturation">
		<field type="double" min="0" max="2" default="1.4" id="saturation"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="comicink.frag"/>
</effect>
