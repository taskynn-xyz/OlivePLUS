<?xml version="1.0" encoding="UTF-8"?>
<effect name="Volumetric Fog" category="Lighting">
	<row name="Density">
		<field type="double" min="0" max="1" default="0.35" id="density"/>
	</row>
	<row name="Scale">
		<field type="double" min="1" max="40" default="6" id="scale"/>
	</row>
	<row name="Speed">
		<field type="double" min="-2" max="2" default="0.2" id="speed"/>
	</row>
	<row name="Light Position">
		<field type="double" min="0" max="1" default="0.5" id="lightX"/>
		<field type="double" min="0" max="1" default="0.4" id="lightY"/>
	</row>
	<row name="Falloff">
		<field type="double" min="0.2" max="10" default="2.5" id="falloff"/>
	</row>
	<row name="Light Intensity">
		<field type="double" min="0" max="6" default="1.2" id="intensity"/>
	</row>
	<row name="Shafts">
		<field type="double" min="0" max="1" default="0.75" id="shafts"/>
	</row>
	<row name="Fog Colour">
		<field type="color" hex="#cfe8ff" id="fogcolor"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="volumefog.frag"/>
</effect>
