<?xml version="1.0" encoding="UTF-8"?>
<effect name="God Rays" category="Lighting">
	<row name="Light Position">
		<field type="double" min="0" max="1" default="0.5" id="sourceX"/>
		<field type="double" min="0" max="1" default="0.35" id="sourceY"/>
	</row>
	<row name="Threshold">
		<field type="double" min="0" max="1" default="0.55" id="threshold"/>
	</row>
	<row name="Length">
		<field type="double" min="0" max="1" default="0.7" id="length"/>
	</row>
	<row name="Decay">
		<field type="double" min="0.5" max="1" default="0.965" id="decay"/>
	</row>
	<row name="Intensity">
		<field type="double" min="0" max="6" default="1.6" id="intensity"/>
	</row>
	<row name="Ray Colour">
		<field type="color" hex="#ffd9a8" id="raycolor"/>
	</row>
	<row name="Screen">
		<field type="double" min="0" max="1" default="0.5" id="screen"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="godrays.frag"/>
</effect>
