<?xml version="1.0" encoding="UTF-8"?>
<effect name="Bloom" category="Community">
	

	<row name="Threshold">
		<field type="double" min="0.0" default="5.0" max="99.0" id="Threshold"/>
	</row>

	<row name="Intensity">
		<field type="double" min="0.0" default="10.0" max="20.0" id="Intensity"/>
	</row>


	<row name="Blur">
		<field type="double" min="0.0" default="8.0" max="64.0" id="BlurSize"/>
	</row>

	<row name="Method">
		<field type="combo" default="0" id="method">
			<option>Gaussian</option>
			<option>Box</option>
			<option>Bokeh</option>
		</field>
	</row>

	<shader vert="../COMMON/common.vert" frag="bloom.frag"/>
</effect>