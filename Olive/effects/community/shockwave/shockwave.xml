<?xml version="1.0" encoding="UTF-8"?>
<effect name="Shockwave" category="Distort">
	<row name="Center X">
		<field type="double" min="-0.5" default="0" max="0.5" id="cx"/>
	</row>
	<row name="Center Y">
		<field type="double" min="-0.5" default="0" max="0.5" id="cy"/>
	</row>
	<row name="Strength">
		<field type="double" min="0" default="1" max="4" id="strength"/>
	</row>
	<row name="Rings">
		<field type="double" min="1" default="18" max="80" id="frequency"/>
	</row>
	<row name="Speed">
		<field type="double" min="-3" default="1" max="3" id="speed"/>
	</row>
	<row name="Chroma">
		<field type="double" min="0" default="2" max="20" id="chroma"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="shockwave.frag"/>
</effect>
