<?xml version="1.0" encoding="UTF-8"?>
<effect name="Duotone" category="Motion Graphics">
	<row name="Shadow Colour">
		<field type="color" hex="#20124d" id="shadow"/>
	</row>
	<row name="Highlight Colour">
		<field type="color" hex="#ffd166" id="highlight"/>
	</row>
	<row name="Amount">
		<field type="double" min="0" default="1" max="1" id="amount"/>
	</row>
	<row name="Contrast">
		<field type="double" min="-1" default="0.2" max="2" id="contrast"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="duotone.frag"/>
</effect>
