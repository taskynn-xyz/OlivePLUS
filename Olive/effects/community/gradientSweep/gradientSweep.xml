<?xml version="1.0" encoding="UTF-8"?>
<effect name="Gradient Sweep" category="Stylize">
	<row name="Start Colour">
		<field type="color" hex="#ff5f6d" id="colorA"/>
	</row>
	<row name="End Colour">
		<field type="color" hex="#ffc371" id="colorB"/>
	</row>
	<row name="Angle">
		<field type="double" min="0" default="90" max="360" id="angle"/>
	</row>
	<row name="Offset">
		<field type="double" min="-1" default="0" max="1" id="offset"/>
	</row>
	<row name="Keep Luminance">
		<field type="bool" default="1" id="keepLuma"/>
	</row>
	<row name="Amount">
		<field type="double" min="0" default="1" max="1" id="amount"/>
	</row>
	<shader vert="../COMMON/common.vert" frag="gradientSweep.frag"/>
</effect>
